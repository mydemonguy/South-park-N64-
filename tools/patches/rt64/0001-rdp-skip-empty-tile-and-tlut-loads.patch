+    // A load whose end precedes its start (lrs < uls or lrt < ult) loads nothing on the
+    // RDP; the unsigned row/word counts below would otherwise wrap to ~4 billion and read
+    // far past RDRAM. (South Park 64 hits this with a LoadTLUT on device.)
+    static bool isEmptyLoad(const char *what, const LoadTile &loadTile, const LoadTexture &loadTexture) {
+        if (((loadTile.lrs >> 2) >= (loadTile.uls >> 2)) && ((loadTile.lrt >> 2) >= (loadTile.ult >> 2))) {
+            return false;
+        }
+        static int reported = 0;
+        if (reported < 8) {
+            reported++;
+            fprintf(stderr, "[rt64] skipped empty %s: uls=%u ult=%u lrs=%u lrt=%u tmem=0x%X address=0x%08X\n",
+                what, unsigned(loadTile.uls), unsigned(loadTile.ult), unsigned(loadTile.lrs), unsigned(loadTile.lrt),
+                unsigned(loadTile.tmem), unsigned(loadTexture.address));
+        }
+        return true;
+    }
