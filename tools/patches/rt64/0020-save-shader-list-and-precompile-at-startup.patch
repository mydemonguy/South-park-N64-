+    // File layout: magic, format version, sizeof(ShaderDescription), then raw descriptions in the
+    // order they were first used. A file from a different layout is discarded and started over.
+    static const char ShaderListMagic[8] = { 'R', 'T', '6', '4', 'S', 'L', 'S', 'T' };
+    static const uint32_t ShaderListVersion = 1;
+
+    void RasterShaderCache::loadShaderList(const std::filesystem::path &path) {
+        std::vector<ShaderDescription> descriptions;
+        {
+            std::ifstream input(path, std::ios::binary);
+            char magic[8] = {};
+            uint32_t version = 0, descSize = 0;
+            if (input.read(magic, sizeof(magic)) && input.read(reinterpret_cast<char *>(&version), sizeof(version)) &&
+                input.read(reinterpret_cast<char *>(&descSize), sizeof(descSize)) &&
+                (std::memcmp(magic, ShaderListMagic, sizeof(magic)) == 0) && (version == ShaderListVersion) &&
+                (descSize == sizeof(ShaderDescription)))
+            {
+                ShaderDescription desc;
+                while ((descriptions.size() < ShaderListMaxEntries) && input.read(reinterpret_cast<char *>(&desc), sizeof(desc))) {
+                    descriptions.push_back(desc);
+                }
+            }
+        }
+
+        {
+            std::unique_lock<std::mutex> queueLock(submissionMutex);
+            shaderListPath = path;
+            shaderListEntries = 0;
+            // Rewrite the file with the entries that were read (drops a torn last entry or an
+            // incompatible file), then keep it open for appending.
+            std::error_code ec;
+            std::filesystem::create_directories(path.parent_path(), ec);
+            if (shaderListStream.is_open()) {
+                shaderListStream.close();
+            }
+
+            shaderListStream.clear();
+            shaderListStream.open(path, std::ios::binary | std::ios::trunc);
+            if (shaderListStream.is_open()) {
+                shaderListStream.write(ShaderListMagic, sizeof(ShaderListMagic));
+                shaderListStream.write(reinterpret_cast<const char *>(&ShaderListVersion), sizeof(ShaderListVersion));
+                const uint32_t descSize = sizeof(ShaderDescription);
+                shaderListStream.write(reinterpret_cast<const char *>(&descSize), sizeof(descSize));
+            }
+
+            uint32_t queued = 0;
+            {
+                const std::unique_lock<std::mutex> descLock(descQueueMutex);
+                for (const ShaderDescription &desc : descriptions) {
+                    bool &found = shaderHashes[desc.hash()];
+                    if (found) {
+                        continue;
+                    }
+
+                    found = true;
+                    descQueue.push(desc);
+                    queued++;
+                    if (shaderListStream.is_open()) {
+                        shaderListStream.write(reinterpret_cast<const char *>(&desc), sizeof(ShaderDescription));
+                        shaderListEntries++;
+                    }
+                }
+            }
+
+            if (shaderListStream.is_open()) {
+                shaderListStream.flush();
+            }
+
+            shaderListLoaded = queued;
+        }
+
+        descQueueChanged.notify_all();
+        fprintf(stderr, "[rt64] shader list: %u shaders from earlier sessions queued for compiling\n", shaderListLoaded);
+    }
+
+    uint32_t RasterShaderCache::loadedShaderListCount() const {
+        return shaderListLoaded;
+    }
