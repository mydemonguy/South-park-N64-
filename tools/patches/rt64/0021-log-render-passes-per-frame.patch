@@ -76,6 +76,23 @@ namespace RT64 {
         shaderWaitMicros.fetch_add(uint64_t(waitedMs * 1000.0), std::memory_order_relaxed);
     }
 
+    static std::atomic<unsigned long long> passTimeNs[PassTimeSlots] = {};
+    static std::atomic<unsigned long long> passTimeCounts[PassTimeSlots] = {};
+
+    void CountPassTime(uint32_t passIndex, unsigned long long ns) {
+        if (passIndex < PassTimeSlots) {
+            passTimeNs[passIndex].fetch_add(ns, std::memory_order_relaxed);
+            passTimeCounts[passIndex].fetch_add(1, std::memory_order_relaxed);
+        }
+    }
+
+    void GetPassTimes(unsigned long long ns[PassTimeSlots], unsigned long long counts[PassTimeSlots]) {
+        for (uint32_t i = 0; i < PassTimeSlots; i++) {
+            ns[i] = passTimeNs[i].load(std::memory_order_relaxed);
+            counts[i] = passTimeCounts[i].load(std::memory_order_relaxed);
+        }
+    }
+
     void GetShaderWaitStats(uint64_t &waits, uint64_t &skipped, double &waitedMs) {
         waits = shaderWaits.load(std::memory_order_relaxed);
         skipped = shaderWaitSkips.load(std::memory_order_relaxed);
