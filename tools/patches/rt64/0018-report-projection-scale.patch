+    static std::atomic<float> lastProjectionX = 0.0f;
+    static std::atomic<float> lastProjectionY = 0.0f;
+
+    void SetLastProjectionScale(float x, float y) {
+        lastProjectionX.store(x, std::memory_order_relaxed);
+        lastProjectionY.store(y, std::memory_order_relaxed);
+    }
+
+    void GetLastProjectionScale(float &x, float &y) {
