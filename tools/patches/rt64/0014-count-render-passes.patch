diff --git a/src/common/rt64_device_workarounds.cpp b/src/common/rt64_device_workarounds.cpp
index 3cfd56b..2fa273c 100644
--- a/src/common/rt64_device_workarounds.cpp
+++ b/src/common/rt64_device_workarounds.cpp
@@ -63,4 +63,22 @@ namespace RT64 {
     bool GetUbershadersEnabled() {
         return ubershadersEnabled.load(std::memory_order_relaxed);
     }
+
+    static std::atomic<unsigned long long> counterWorkloads = 0;
+    static std::atomic<unsigned long long> counterFramebufferPairs = 0;
+    static std::atomic<unsigned long long> counterDepthSwitches = 0;
+
+    void CountWorkload(unsigned int framebufferPairs) {
+        counterWorkloads.fetch_add(1, std::memory_order_relaxed);
+        counterFramebufferPairs.fetch_add(framebufferPairs, std::memory_order_relaxed);
+    }
+
+    void CountDepthSwitch() {
+        counterDepthSwitches.fetch_add(1, std::memory_order_relaxed);
+    }
+
+    RenderCounters GetRenderCounters() {
+        return { counterWorkloads.load(std::memory_order_relaxed), counterFramebufferPairs.load(std::memory_order_relaxed),
+            counterDepthSwitches.load(std::memory_order_relaxed) };
+    }
 };
diff --git a/src/common/rt64_device_workarounds.h b/src/common/rt64_device_workarounds.h
index 3889464..df7e141 100644
--- a/src/common/rt64_device_workarounds.h
+++ b/src/common/rt64_device_workarounds.h
@@ -45,4 +45,18 @@ namespace RT64 {
     // (it appears once its shader has compiled, usually within a few frames).
     void SetUbershadersEnabled(bool enabled);
     bool GetUbershadersEnabled();
+
+    // Diagnostics: running totals the host divides by the number of frames to report
+    // per-frame figures. A depth switch flips the depth buffer between writable and
+    // read-only (for decal draws), which ends the render pass; on a tiled GPU every
+    // pass end writes the whole colour and depth target out to memory and the next
+    // pass reads it back, so this count is what makes high resolutions expensive there.
+    struct RenderCounters {
+        unsigned long long workloads;
+        unsigned long long framebufferPairs;
+        unsigned long long depthSwitches;
+    };
+    void CountWorkload(unsigned int framebufferPairs);
+    void CountDepthSwitch();
+    RenderCounters GetRenderCounters();
 };
