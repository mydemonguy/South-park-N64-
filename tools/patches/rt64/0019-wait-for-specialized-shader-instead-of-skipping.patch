+#include <chrono>
+#include <mutex>
+#include <thread>
+
+namespace RT64 {
+    // Waits up to 25 ms for one draw's specialized shader, and at most 150 ms in any one-second
+    // window, so a burst of new materials costs a short hitch instead of freezing. Only reached
+    // on a cache miss with ubershaders disabled.
+    static RasterShader *waitForSpecializedShader(RasterShaderCache *cache, const ShaderDescription &desc) {
+        using Clock = std::chrono::steady_clock;
+        static std::mutex budgetMutex;
+        static Clock::time_point windowStart = Clock::now();
+        static double windowWaitedMs = 0.0;
+        constexpr double PerDrawMs = 25.0;
+        constexpr double PerSecondMs = 150.0;
+
+        const Clock::time_point start = Clock::now();
+        double allowedMs;
+        {
+            const std::lock_guard<std::mutex> lock(budgetMutex);
+            if (std::chrono::duration<double>(start - windowStart).count() >= 1.0) {
+                windowStart = start;
+                windowWaitedMs = 0.0;
+            }
+            allowedMs = std::min(PerDrawMs, PerSecondMs - windowWaitedMs);
+        }
+
+        // Submitting again is a no-op if the shader is already queued or compiled.
+        cache->submit(desc);
+        RasterShader *shader = cache->getGPUShader(desc);
+        while ((shader == nullptr) && (allowedMs > 0.0) &&
+               (std::chrono::duration<double, std::milli>(Clock::now() - start).count() < allowedMs)) {
+            std::this_thread::sleep_for(std::chrono::microseconds(500));
+            shader = cache->getGPUShader(desc);
+        }
+
+        const double waitedMs = std::chrono::duration<double, std::milli>(Clock::now() - start).count();
+        {
+            const std::lock_guard<std::mutex> lock(budgetMutex);
+            windowWaitedMs += waitedMs;
+        }
+
+        CountShaderWait(waitedMs, shader != nullptr);
+        return shader;
+    }
+};
