diff --git a/src/common/rt64_device_workarounds.cpp b/src/common/rt64_device_workarounds.cpp
index 3aa9b4e..3cfd56b 100644
--- a/src/common/rt64_device_workarounds.cpp
+++ b/src/common/rt64_device_workarounds.cpp
@@ -50,4 +50,17 @@ namespace RT64 {
     bool GetFramebufferSyncEnabled() {
         return framebufferSyncEnabled.load(std::memory_order_relaxed);
     }
+
+    static std::atomic<bool> ubershadersEnabled = true;
+
+    void SetUbershadersEnabled(bool enabled) {
+        const bool previous = ubershadersEnabled.exchange(enabled, std::memory_order_relaxed);
+        if (previous != enabled) {
+            fprintf(stderr, "[rt64] ubershaders %s\n", enabled ? "ENABLED" : "DISABLED (driver workaround: a draw waits for its specialized shader)");
+        }
+    }
+
+    bool GetUbershadersEnabled() {
+        return ubershadersEnabled.load(std::memory_order_relaxed);
+    }
 };
diff --git a/src/common/rt64_device_workarounds.h b/src/common/rt64_device_workarounds.h
index df0202d..3889464 100644
--- a/src/common/rt64_device_workarounds.h
+++ b/src/common/rt64_device_workarounds.h
@@ -36,4 +36,13 @@ namespace RT64 {
     // otherwise, not a performance option.
     void SetFramebufferSyncEnabled(bool enabled);
     bool GetFramebufferSyncEnabled();
+
+    // Drawing with the ubershader (the general raster shader used while a draw's
+    // specialized shader is still compiling). On Qualcomm's proprietary driver
+    // (Adreno 710, driver 0x80320046) the GPU is lost ~2 s into the first game frames,
+    // with framebuffer sync off as well, while Turnip on the same device is fine.
+    // Disabled, a draw whose specialized shader is not ready yet is skipped instead
+    // (it appears once its shader has compiled, usually within a few frames).
+    void SetUbershadersEnabled(bool enabled);
+    bool GetUbershadersEnabled();
 };
