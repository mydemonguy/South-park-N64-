+    // GPU breadcrumbs (South Park 64 diagnostics for Qualcomm's proprietary driver, which
+    // loses the device on the first game frames). Before each dispatch, render pass and the
+    // end of each command list, the GPU waits for all earlier work and writes the step's
+    // number into host-visible memory; when the device is lost, the number left there names
+    // the step that was running. Only on that driver, and only for the first steps.
+    namespace {
+        constexpr uint32_t CrumbLabelCount = 2048;
+        constexpr uint32_t CrumbMaxSteps = 6000;
+        std::atomic<bool> crumbsEnabled{false};
+        std::atomic<bool> crumbsReported{false};
+        std::atomic<uint32_t> crumbNext{1};
+        VkBuffer crumbBuffer = VK_NULL_HANDLE;
+        VmaAllocation crumbAllocation = VK_NULL_HANDLE;
+        volatile uint32_t *crumbMapped = nullptr;
+        std::mutex crumbMutex;
+        std::string crumbLabels[CrumbLabelCount];
+
+        void crumbsReport(const char *where) {
+            if (!crumbsEnabled.load() || crumbsReported.exchange(true)) {
+                return;
+            }
+            const uint32_t last = crumbMapped[0];
+            const uint32_t recorded = crumbNext.load() - 1;
+            std::scoped_lock lock(crumbMutex);
+            fprintf(stderr, "[gpu] DEVICE LOST (seen at %s). Last step the GPU started: #%u of %u recorded\n", where, last, recorded);
+            const uint32_t from = (last > 8) ? last - 8 : 1;
+            for (uint32_t i = from; (i <= last + 3) && (i <= recorded); i++) {
+                fprintf(stderr, "[gpu] %s #%u %s\n", (i == last) ? "->" : "  ", i, crumbLabels[i % CrumbLabelCount].c_str());
+            }
+        }
+    }
+
+    static void crumbsSetup(VulkanDevice *device, const RenderDeviceDescription &description) {
+        const bool qualcommProprietary = (uint32_t(description.vendor) == 0x5143) && (description.name.find("Turnip") == std::string::npos);
+        if (!qualcommProprietary || (crumbBuffer != VK_NULL_HANDLE)) {
+            return;
+        }
+        VkBufferCreateInfo bufferInfo = {};
+        bufferInfo.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO;
+        bufferInfo.size = 256;
+        bufferInfo.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+        bufferInfo.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+        VmaAllocationCreateInfo allocInfo = {};
+        allocInfo.usage = VMA_MEMORY_USAGE_AUTO;
+        allocInfo.flags = VMA_ALLOCATION_CREATE_HOST_ACCESS_RANDOM_BIT | VMA_ALLOCATION_CREATE_MAPPED_BIT;
+        allocInfo.requiredFlags = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+        VmaAllocationInfo info = {};
+        VkResult res = vmaCreateBuffer(device->allocator, &bufferInfo, &allocInfo, &crumbBuffer, &crumbAllocation, &info);
+        if ((res != VK_SUCCESS) || (info.pMappedData == nullptr)) {
+            fprintf(stderr, "[gpu] breadcrumbs unavailable (0x%X)\n", res);
+            crumbBuffer = VK_NULL_HANDLE;
+            return;
+        }
+        crumbMapped = reinterpret_cast<volatile uint32_t *>(info.pMappedData);
+        crumbMapped[0] = 0;
+        crumbsEnabled = true;
+        fprintf(stderr, "[gpu] breadcrumbs on (Qualcomm proprietary driver): the step running when the device is lost will be logged\n");
+    }
+
+    uint32_t VulkanCommandList::breadcrumb(const std::string &label) {
+        if (!crumbsEnabled.load(std::memory_order_relaxed) || (activeRenderPass != VK_NULL_HANDLE) || crumbsReported.load(std::memory_order_relaxed)) {
+            return 0;
+        }
+        const uint32_t id = crumbNext.fetch_add(1);
+        if (id > CrumbMaxSteps) {
+            return 0;
+        }
+        {
+            std::scoped_lock lock(crumbMutex);
+            crumbLabels[id % CrumbLabelCount] = label;
+        }
+        VkMemoryBarrier barrier = {};
+        barrier.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER;
+        barrier.srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT;
+        barrier.dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+        vkCmdPipelineBarrier(vk, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 1, &barrier, 0, nullptr, 0, nullptr);
+        vkCmdFillBuffer(vk, crumbBuffer, 0, 4, id);
+        return id;
+    }
