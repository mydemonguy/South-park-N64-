+// Some games (e.g. South Park) run code through a TLB mapping (0x00200000 + phys, or a
+// dynamically mapped block) but read jump tables through KSEG0 (0x80000000 + phys).
+// Those tables live in the boot image that IPL3/the game copies from ROM 0x1000 to
+// RAM 0x80000400, so a KSEG0 table address maps straight to a ROM offset.
+static uint32_t jtbl_rom_addr(const N64Recomp::Function& func, uint32_t vram) {
+    constexpr uint32_t boot_ram = 0x80000400u;
+    constexpr uint32_t boot_rom = 0x1000u;
+    constexpr uint32_t boot_size = 0x100000u;
+    if (func.vram < 0x80000000u && vram >= boot_ram && vram < boot_ram + boot_size) {
+        return vram - boot_ram + boot_rom;
+    }
+    return vram + func.rom - func.vram;
+}
